# HubSpot developer sandbox: https://developers.hubspot.com/get-started
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Airtable personal access token: https://airtable.com/create/tokens
# Required scopes: data.records:read, data.records:write, schema.bases:read, webhook:manage
AIRTABLE_API_KEY=patXXXXXXXXXXXX.XXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXX
AIRTABLE_WEBHOOK_SECRET=whatever-you-set-in-the-airtable-automation

# Server config for the Part 2 middleware
PORT=8080
LOG_LEVEL=info

# Toggle for the migration script — 1 means print planned writes, don't call HubSpot
DRY_RUN=0

# Optional. If set, the migrate script only processes this many rows per entity
# (useful for a fast smoke test against a real sandbox).
MIGRATE_LIMIT=
